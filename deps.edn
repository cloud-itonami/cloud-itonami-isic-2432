{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). Both
 ;; live in the kotoba-lang org of this workspace. This repo is
 ;; standalone (forkable outside the workspace); the :local/root paths
 ;; only resolve inside the monorepo checkout -- a standalone fork
 ;; should override them with git coordinates. langchain is pinned here
 ;; directly (not only under :dev) so a bare `kbb -M:test` works
 ;; offline inside the monorepo checkout without depending on
 ;; langgraph's own transitive git/sha pin being fetchable.
 :deps {
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.robotics"}

        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.test"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.io"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.coll"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.edn"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "96a82d9612d7f3699f93323bad0c68355b8f7cc9"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/kotoba/lib/kotoba.langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        ;; jp-go-dds (デジタル庁デザインシステム) -- this workspace's BASE
        ;; design system. Used ONLY by `nonferrousmfg.render-html` to skin
        ;; the build-time operator console; the actor itself has no UI dep.
        ;; Pinned by git sha (not :local/root) so a standalone fork can
        ;; still regenerate the page.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "0ea3c03d6bb1ff89808e1fb57be897b902a3513d"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  :physai-test {:extra-paths ["test" "test-physai"] :main-opts ["-m" "cognitect.test-runner"]}
;; offline workspace dev -- pin transitive langchain to local checkout
  ;; (kept for parity with sibling actors' deps.edn shape; redundant
  ;; with the top-level :deps override above).
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "nonferrousmfg.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by driving the REAL actor
  ;; (flagship checklist item 2). Refuses to write a page whose ledger
  ;; contains no HARD governor hold.
  :render-html {:main-opts ["-m" "nonferrousmfg.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
